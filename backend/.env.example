# 数据库配置
DATABASE_URL="postgresql://gattefosse:gattefosse_dev@localhost:5432/gattefosse_db?schema=public"

# JWT 密钥
JWT_SECRET="Gattefosse_JWT_Secret_Key_2026_Change_In_Production"
JWT_EXPIRES_IN="7d"

# 服务器配置
PORT=3000
NODE_ENV="development"

# 文件上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# 求职简历私有存储（不挂静态目录，仅经后台鉴权接口下载）
RESUME_DIR="./storage/resumes"
RESUME_MAX_FILE_SIZE=2097152

# 邮件通知（求职申请）—— 也可直接在后台「系统设置 → 邮件通知」填写，settings 表优先
# SMTP_ENABLED="true"
# SMTP_HOST="smtp.exmail.qq.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="hr@yourcompany.com"
# SMTP_PASS="客户端专用密码"
# SMTP_FROM="hr@yourcompany.com"
# SMTP_FROM_NAME="Gattefossé China"
# HR_NOTIFY_EMAIL="hr@yourcompany.com"

# Redis 配置（可选，用于 Session 和限流）
REDIS_URL="redis://localhost:6379"

# 前端站点地址（CORS 白名单）
FRONTEND_URL="http://localhost:8000"
