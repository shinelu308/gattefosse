# ===== 生产环境配置模板 =====
# 使用方法：上传到服务器后，复制为 backend/.env 并修改下面 3 处带 ★ 的内容

# 数据库：SQLite 文件（项目自带，无需安装数据库软件）
DATABASE_URL="file:./gattefosse.db"

# ★ 第 1 处：换成随机长字符串（可用 https://www.random.org/strings/ 生成 32 位）
JWT_SECRET="请改成一串随机字符_例如_a8f3Kd92LmQ7xZpR4vBn6WsYt"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV="production"

# 文件上传目录
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ★ 第 2 处：改成你的正式域名（前面带 https）
FRONTEND_URL="https://www.你的域名.com"

# ★ 第 3 处：改成你的正式域名（前面带 https）
BASE_URL="https://www.你的域名.com"
